{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meeting-summary",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // One public origin (session cookies and the Google callback are tied to it). The workers.dev
  // address is off; per-version preview URLs stay on for PR previews.
  "routes": [{ "pattern": "student-paltform.phocoenoides.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/ws/*", "/mcp", "/mcp/*", "/files/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meeting-summary",
      "database_id": "13e63aec-d5c3-4ece-80a5-65902648a185",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "meeting-summary-files" }],
  "durable_objects": { "bindings": [{ "name": "DOC_ROOM", "class_name": "DocRoom" }, { "name": "OUTBOX", "class_name": "Outbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }, { "tag": "v2", "new_sqlite_classes": ["Outbox"] }],
  "vars": {
    "APP_VERSION": "0.1.0",
    // OWNER_EMAILS, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and GITHUB_TOKEN are Worker secrets
    // (`wrangler secret put`) so emails stay out of this public repo.
    "GITHUB_REPO": "deadline314/meeting-summary",
    "GRADER_MODE": "github",
    // Public origin of the site, sent to the grading workflow so it knows where to report.
    "SITE_URL": "https://student-paltform.phocoenoides.com",
    // Sender for email notifications; its domain must be verified in Resend. Mail is only sent
    // when the RESEND_API_KEY secret is set too.
    "EMAIL_FROM": "noreply@phocoenoides.com"
  }
}

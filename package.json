{
  "name": "meeting-summary",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc -b",
    "lint": "eslint . && node scripts/check-colors.mjs && node scripts/check-contrast.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "types": "wrangler types src/worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
